# ---------------------------------------------------------------------------
# API TravelCol — variables de entorno (copiar a apps/api/.env para desarrollo).
# NUNCA subas valores reales al repositorio. Documentación: docs/variables-de-entorno.md
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://travelcol:cambia-esta-clave@localhost:5432/travelcol_dev
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# COOKIE_SECURE=true            # automático en producción
# COOKIE_DOMAIN=travelcol.online
SESSION_TTL_HOURS=168
# Sal para seudonimizar IP en auditoría (mín. 16 caracteres). Obligatoria y propia en producción.
IP_HASH_SALT=dev-only-ip-salt-change-me
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
BOOKING_HOLD_MINUTES=20
DEFAULT_COMMISSION_BPS=1200
JOBS_ENABLED=true
STORAGE_DIR=./storage
# SWAGGER_ENABLED=false         # por defecto: activo fuera de producción
LOG_LEVEL=info

# ---- Wompi (Sandbox) ----
# Obtén las llaves en el panel de comercios de Wompi > Desarrolladores (modo Sandbox).
# Las llaves privadas y secretos SOLO van en el servidor (nunca en la web ni en el navegador).
WOMPI_ENV=SANDBOX
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# true = antes de confirmar, la API consulta la transacción en Wompi con la llave privada.
WOMPI_VERIFY_WITH_API=false

# ---- Correo ----
# "log" escribe los correos en el registro y en la tabla email_outbox (no envía). Integrar un
# proveedor SMTP/API es una tarea pendiente documentada.
MAIL_DRIVER=log
MAIL_FROM="TravelCol.online <no-responder@travelcol.online>"

# ---- Semilla ----
SEED_ADMIN_EMAIL=admin@travelcol.local
# SEED_ADMIN_PASSWORD=          # obligatoria en producción
SEED_DEMO=true                  # datos de demostración (prohibidos en producción)
