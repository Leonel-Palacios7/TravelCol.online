{
  "name": "@travelcol/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de TravelCol.online (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts",
    "wompi:simulate": "ts-node --transpile-only scripts/simulate-wompi-event.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "@travelcol/contracts": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}