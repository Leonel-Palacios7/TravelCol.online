{
  "name": "travelcol",
  "private": true,
  "description": "TravelCol.online — marketplace turístico de Colombia (piloto Villeta, Cundinamarca)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:migrate": "pnpm --filter @travelcol/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @travelcol/api db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
